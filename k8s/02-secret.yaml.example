# TEMPLATE ONLY -- this file is committed to git; the real k8s/02-secret.yaml
# is not (see .gitignore). Kubernetes Secret values are base64-ENCODED, not
# encrypted -- anyone who can `kubectl get secret -o yaml` this can decode it
# in one line. That's why it never goes in version control, even with fake
# demo values.
#
# Generate the real file with:
#
#   kubectl create secret generic policyledger-secret \
#     --namespace policyledger \
#     --from-literal=POSTGRES_PASSWORD='<password>' \
#     --from-literal=DATABASE_URL='postgresql+psycopg2://policyledger:<password>@postgres:5432/policyledger' \
#     --dry-run=client -o yaml > k8s/02-secret.yaml
#
# (This project's demo password is the same one already sitting in
# docker-compose.yml -- "policyledger" -- because this is synthetic data
# with no real value to protect. A real deployment would generate a random
# one and pull it from a secrets manager, not type it by hand.)
apiVersion: v1
kind: Secret
metadata:
  name: policyledger-secret
  namespace: policyledger
type: Opaque
stringData:
  POSTGRES_PASSWORD: "<fill-in>"
  DATABASE_URL: "postgresql+psycopg2://policyledger:<fill-in>@postgres:5432/policyledger"
